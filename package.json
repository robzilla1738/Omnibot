{
  "name": "omnibot",
  "private": true,
  "version": "0.1.1",
  "description": "Omnibot \u2014 Local AI bots, projects, and group chats powered by your coding CLIs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "pnpm setup:sparkle && PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" tauri dev",
    "tauri:build": "pnpm setup:sparkle && PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" tauri build",
    "test": "playwright test",
    "test:rust": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "setup:sparkle": "python3 scripts/setup-sparkle.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.562.0",
    "marked": "^15.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robzilla1738/Omnibot.git"
  },
  "bugs": {
    "url": "https://github.com/robzilla1738/Omnibot/issues"
  },
  "homepage": "https://github.com/robzilla1738/Omnibot#readme",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  }
}
