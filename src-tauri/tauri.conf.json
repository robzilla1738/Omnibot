{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnibot",
  "version": "0.1.1",
  "identifier": "com.robzilla1738.botfinity",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Omnibot",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "dragDropEnabled": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; frame-src 'self' http://127.0.0.1:* blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "frameworks": [
        "./Sparkle.framework"
      ],
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../LICENSE": "licenses/Omnibot-MIT.txt",
      "../licenses/T3-Code-MIT.txt": "licenses/T3-Code-MIT.txt",
      "../licenses/Lucide-ISC.txt": "licenses/Lucide-ISC.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/xterm-MIT.txt": "licenses/xterm-MIT.txt",
      "../licenses/portable-pty-MIT.txt": "licenses/portable-pty-MIT.txt",
      "../licenses/Sparkle.txt": "licenses/Sparkle.txt"
    }
  },
  "mainBinaryName": "Omnibot"
}
